/-- Theorem 34 (Exact Unimodular 23x23 Smith Normal Form of Nauru Graph `Y`):
    Proves `U_Y, V_Y ∈ GL_23(Z)` (`U_Y · U_Y⁻¹ = U_Y⁻¹ · U_Y = I_23`,
    `V_Y · V_Y⁻¹ = V_Y⁻¹ · V_Y = I_23`), `U_Y · L̃_Y · V_Y = diag(1^17, 5, 5, 5, 30, 120, 360)`
    directly from `nauruAdj`, and the divisibility chain `s_i | s_{i+1}`. -/
theorem thm34_nauru_exact_unimodular_snf :
    matMul23 snfUY snfUYinv = eye23 ∧
    matMul23 snfUYinv snfUY = eye23 ∧
    matMul23 snfVY snfVYinv = eye23 ∧
    matMul23 snfVYinv snfVY = eye23 ∧
    matMul23 (matMul23 snfUY nauruReducedLap) snfVY = diagMat23 snfDiagY ∧
    isDivChain snfDiagY = true := by
  refine ⟨?_, ?_, ?_, ?_, ?_, rfl⟩
  · simp only [matMul23, h_UYinvT, h_eye]; rfl
  · simp only [matMul23, h_UYT, h_eye]; rfl
  · simp only [matMul23, h_VYinvT, h_eye]; rfl
  · simp only [matMul23, h_VYT, h_eye]; rfl
  · simp only [matMul23, h_lapY, h_lapYT, h_UY_L, h_VYT, h_diagY]; rfl

/-- Theorem 35 (Exact Unimodular 23x23 Smith Normal Form of `Dic_6` Twin `Z`):
    Proves `U_Z, V_Z ∈ GL_23(Z)` (`U_Z · U_Z⁻¹ = U_Z⁻¹ · U_Z = I_23`,
    `V_Z · V_Z⁻¹ = V_Z⁻¹ · V_Z = I_23`), `U_Z · L̃_Z · V_Z = diag(1^18, 4, 52, 52, 1820, 21840)`
    directly from `dic6Adj`, and the divisibility chain `s_i | s_{i+1}`. -/
theorem thm35_dic6_exact_unimodular_snf :
    matMul23 snfUZ snfUZinv = eye23 ∧
    matMul23 snfUZinv snfUZ = eye23 ∧
    matMul23 snfVZ snfVZinv = eye23 ∧
    matMul23 snfVZinv snfVZ = eye23 ∧
    matMul23 (matMul23 snfUZ dic6ReducedLap) snfVZ = diagMat23 snfDiagZ ∧
    isDivChain snfDiagZ = true := by
  refine ⟨?_, ?_, ?_, ?_, ?_, rfl⟩
  · simp only [matMul23, h_UZinvT, h_eye]; rfl
  · simp only [matMul23, h_UZT, h_eye]; rfl
  · simp only [matMul23, h_VZinvT, h_eye]; rfl
  · simp only [matMul23, h_VZT, h_eye]; rfl
  · simp only [matMul23, h_lapZ, h_lapZT, h_UZ_L, h_VZT, h_diagZ]; rfl

end TriadicNauru

